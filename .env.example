# =====================================================================
# Variaveis do Marketing OS.
#
# A lista abaixo e conferida por apps/web/test/env.test.mjs: toda variavel
# que o codigo do servidor le tem de aparecer aqui. Uma variavel esquecida e
# a causa mais comum de deploy que builda e nao roda.
#
# Para subir na Vercel, ver docs/runbooks/deploy-vercel.md.
# =====================================================================

# ── Banco ────────────────────────────────────────────────────────────────
# O projeto de VERDADE e o da org Olga. NAO use ogmypcbaqcamguqbhxjo: aquele e
# o projeto orfao que o HANDOFF §3.3 manda apagar, e apontar para ele grava
# dado num banco que ninguem olha.
DATABASE_URL=

# O schema. O default do codigo e `mkt`, e neste projeto `mkt` NAO e nosso —
# ver o aviso no topo do HANDOFF. Em producao isto precisa valer mkt_v2.
MKT_SCHEMA=mkt_v2

# Postgres local para os testes contra banco (npm run test:rls)
TEST_DATABASE_URL=postgres://postgres@localhost:5432/olga_test

# ── Autenticacao ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Valida a ASSINATURA do token da sessao (apps/web/lib/session.mjs). Sem ela o
# login falha com PROVIDER_UNAVAILABLE. E secret de verdade: quem a tem forja
# sessao de qualquer usuario.
SUPABASE_JWT_SECRET=

# So para o cliente. O servidor prefere as de cima e cai nestas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Model Gateway ────────────────────────────────────────────────────────
# Sem ela o loop de agente nao monta (agentLoop fica null) e /api/agent
# devolve 503. O resto do produto sobe.
ANTHROPIC_API_KEY=

# ── Publicacao ───────────────────────────────────────────────────────────
# fake (padrao) roda o produto inteiro de ponta a ponta sem tocar na Meta.
# real exige o app review, que nao saiu (ADR-0008). Valor invalido derruba o
# boot de proposito, em vez de virar fake em silencio.
META_ADAPTER=fake

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/connections/meta/callback

# ── Workflow duravel (ADR-0001) ──────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# 1 forca modo dev. Em producao deixe vazio: o codigo ja usa NODE_ENV.
INNGEST_DEV=

# ── Observabilidade (ADR-0004) ───────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
