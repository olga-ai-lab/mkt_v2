# Supabase - Olga's Project, org "Sistemas OLGA PRO"
#
# Este e o projeto CERTO. O arquivo apontava para ogmypcbaqcamguqbhxjo, que e
# o projeto orfao descrito em docs/HANDOFF.md §3.3 — vazio, sem nada nosso, e
# custando dinheiro. Um .env.example que aponta para o lugar errado e pior que
# um sem valor nenhum: quem copia acredita nele.
#
# MKT_SCHEMA importa: `mkt` e `rh` neste projeto NAO sao nossos, sao schemas
# que ja existiam com dados da Olga. Nosso alvo e mkt_v2, sempre.
SUPABASE_URL=https://emumzyejysosywlsridm.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MKT_SCHEMA=mkt_v2
DATABASE_URL=

# Postgres local para os testes de RLS (npm run test:rls)
TEST_DATABASE_URL=postgres://postgres@localhost:5433/olga_test

# Model Gateway
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observabilidade (ADR-004)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Meta Graph - Instagram + Facebook (ADR-0008)
#
# META_ADAPTER decide se o produto fala com a Meta de verdade. O padrao e
# `fake`, e nao e esquecimento: enquanto o app review nao sair, `real` nao tem
# como funcionar. Com `fake` o produto roda de ponta a ponta e nada sai para
# uma conta real.
META_ADAPTER=fake
META_APP_ID=
META_APP_SECRET=
# A rota existe: apps/web/app/api/connections/meta/callback/route.ts.
# Ela precisa bater exatamente com o que estiver cadastrado no app da Meta.
META_REDIRECT_URI=http://localhost:3000/api/connections/meta/callback

# Onde o token da conexao e guardado (ADR-0014).
#
# `supabase` usa o Supabase Vault, que GRAVA — e o unico que serve para
# conectar canal pelo navegador, porque o callback recebe o token em tempo de
# execucao. Sem isto, o vault e o resolvedor por variavel de ambiente, que
# resolve e RECUSA gravar, dizendo por que.
#
# O padrao e o que nao grava de proposito: um vault escolhido por engano deve
# falhar ao conectar, e nao guardar o token no lugar errado.
META_VAULT=

# Token colado a mao, para o deploy simples sem Vault. Um secret_ref de
# `vault://meta/ig-123` procura META_SECRET_META_IG_123.
# META_SECRET_META_IG_123=

# Inngest (ADR-0001). O motor duravel continua sendo ele no Railway: a
# ADR-0012 trocou a Vercel, nao o Inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# O host publico por onde o Inngest chama /api/inngest. Atras do proxy do
# Railway o Next nao adivinha o host externo, e errar aqui NAO da erro: o
# workflow simplesmente nunca e chamado.
INNGEST_SERVE_ORIGIN=https://seu-app.up.railway.app

# Railway injeta PORT em runtime; o Dockerfile traz 3000 como padrao.
PORT=3000
