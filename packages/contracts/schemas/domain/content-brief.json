{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "olga://domain/content-brief",
  "title": "ContentBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "channels",
    "brand_brain_version_id"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 3
    },
    "angle": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "olga://enums/channel"
      }
    },
    "insurance_product": {
      "type": [
        "string",
        "null"
      ]
    },
    "persona": {
      "type": [
        "string",
        "null"
      ]
    },
    "cta": {
      "type": [
        "string",
        "null"
      ]
    },
    "brand_brain_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_kind": {
      "enum": [
        "BRIEFING",
        "FILE",
        "PHOTO",
        "INSIGHT"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
