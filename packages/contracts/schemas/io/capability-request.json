{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "olga://io/capability-request",
  "title": "CapabilityRequest",
  "description": "Pedido tipado ao Capability Gateway. args e produzido pelo compiler deterministico.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "tenant",
    "capability_id",
    "capability_version",
    "mode",
    "args",
    "idempotency_key"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org_id",
        "workspace_id"
      ],
      "properties": {
        "org_id": {
          "type": "string",
          "format": "uuid"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_type": {
          "enum": [
            "user",
            "agent",
            "system",
            "provider"
          ]
        },
        "actor_id": {
          "type": "string"
        },
        "actor_role": {
          "enum": [
            "OWNER",
            "MARKETING",
            "APPROVER"
          ]
        }
      }
    },
    "capability_id": {
      "type": "string"
    },
    "capability_version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "$ref": "olga://enums/capability-mode"
    },
    "args": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "description": "Chave estavel por efeito material. Nunca derivada apenas de texto livre do LLM (MKT-09 03)."
    },
    "requested_autonomy": {
      "$ref": "olga://enums/autonomy"
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
