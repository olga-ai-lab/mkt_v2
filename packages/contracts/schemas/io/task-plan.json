{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "olga://io/task-plan",
  "title": "TaskPlan",
  "description": "Plano proposto pelo agente. Proposta, nao autorizacao.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "tenant",
    "agent_id",
    "agent_version",
    "steps"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org_id",
        "workspace_id"
      ],
      "properties": {
        "org_id": {
          "type": "string",
          "format": "uuid"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_type": {
          "enum": [
            "user",
            "agent",
            "system",
            "provider"
          ]
        },
        "actor_id": {
          "type": "string"
        },
        "actor_role": {
          "enum": [
            "OWNER",
            "MARKETING",
            "APPROVER"
          ]
        }
      }
    },
    "agent_id": {
      "type": "string"
    },
    "agent_version": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "capability_id",
          "mode",
          "args_summary"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "capability_id": {
            "type": "string"
          },
          "mode": {
            "$ref": "olga://enums/capability-mode"
          },
          "args_summary": {
            "type": "string",
            "description": "Resumo humano. Os args reais sao construidos pelo compiler, nunca pelo LLM."
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "expected_outcome": {
      "type": "string"
    }
  }
}
